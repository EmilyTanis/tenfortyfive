{
  "$description": "ten forty five brand tokens v1.0 (approved November 2026). W3C Design Tokens format.",
  "color": {
    "midnight": { "$type": "color", "$value": "#142C3B", "$description": "Primary. Text, dark grounds. RGB 20 44 59." },
    "steel":    { "$type": "color", "$value": "#52788F", "$description": "Accent. Max 10% of a layout. RGB 82 120 143." },
    "mist":     { "$type": "color", "$value": "#A9BDC9", "$description": "Support. Text and rules on dark grounds. RGB 169 189 201." },
    "cloud":    { "$type": "color", "$value": "#EDF2F5", "$description": "Surface. Panels, cards, hairlines. RGB 237 242 245." },
    "white":    { "$type": "color", "$value": "#FFFFFF", "$description": "Base. RGB 255 255 255." },
    "text": {
      "primary":   { "$type": "color", "$value": "{color.midnight}" },
      "secondary": { "$type": "color", "$value": "{color.steel}" },
      "on-dark":   { "$type": "color", "$value": "{color.white}" },
      "on-dark-secondary": { "$type": "color", "$value": "{color.mist}" }
    },
    "background": {
      "default": { "$type": "color", "$value": "{color.white}" },
      "surface": { "$type": "color", "$value": "{color.cloud}" },
      "inverse": { "$type": "color", "$value": "{color.midnight}" },
      "accent":  { "$type": "color", "$value": "{color.steel}" }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Inter Tight", "Inter", "system-ui", "sans-serif"] },
      "body":    { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
      "mono":    { "$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "monospace"] },
      "accent":  { "$type": "fontFamily", "$value": ["Instrument Serif", "Georgia", "serif"], "$description": "Italic only. One phrase per layout, never a whole headline, never in the logo." }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 }
    }
  },
  "typography": {
    "display":  { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": 600, "fontSize": "76px", "lineHeight": 1.0, "letterSpacing": "-0.045em" } },
    "h1":       { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": 600, "fontSize": "56px", "lineHeight": 1.02, "letterSpacing": "-0.04em" } },
    "h2":       { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": 600, "fontSize": "40px", "lineHeight": 1.05, "letterSpacing": "-0.025em" } },
    "h3":       { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": 600, "fontSize": "28px", "lineHeight": 1.1, "letterSpacing": "-0.025em" } },
    "body-lg":  { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": 400, "fontSize": "17px", "lineHeight": 1.55, "letterSpacing": "0" } },
    "body":     { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": 400, "fontSize": "15px", "lineHeight": 1.6, "letterSpacing": "0" } },
    "label":    { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontWeight": 400, "fontSize": "11px", "lineHeight": 1.4, "letterSpacing": "0.08em", "textTransform": "uppercase" } },
    "figure":   { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": 600, "fontSize": "56px", "lineHeight": 1.0, "letterSpacing": "-0.05em" } },
    "accent":   { "$type": "typography", "$value": { "fontFamily": "{font.family.accent}", "fontStyle": "italic", "fontWeight": 400, "fontSize": "1.1em", "lineHeight": 0.9, "letterSpacing": "-0.01em" } },
    "wordmark": { "$type": "typography", "$value": { "fontFamily": "{font.family.display}", "fontWeight": 600, "lineHeight": 1.0, "letterSpacing": "-0.045em", "textTransform": "lowercase" } }
  },
  "space": {
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "20px", "$description": "Grid gutter" },
    "6":  { "$type": "dimension", "$value": "24px" },
    "8":  { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px", "$description": "Page margin, desktop" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "24": { "$type": "dimension", "$value": "96px", "$description": "Section spacing" }
  },
  "layout": {
    "columns":     { "$type": "number", "$value": 12 },
    "gutter":      { "$type": "dimension", "$value": "20px" },
    "margin":      { "$type": "dimension", "$value": "40px", "$description": "16px at phone width" },
    "max-width":   { "$type": "dimension", "$value": "1280px" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px", "$description": "The brand uses square corners everywhere, including buttons and the compact mark." }
  },
  "border": {
    "hairline":      { "$type": "border", "$value": { "color": "{color.cloud}", "width": "1px", "style": "solid" } },
    "hairline-dark": { "$type": "border", "$value": { "color": "{color.mist}", "width": "1px", "style": "solid" } },
    "rule-strong":   { "$type": "border", "$value": { "color": "{color.midnight}", "width": "1px", "style": "solid" } }
  },
  "shadow": {
    "object": { "$type": "shadow", "$value": { "color": "#142C3B59", "offsetX": "0px", "offsetY": "30px", "blur": "60px", "spread": "-30px" }, "$description": "Only for physical mockups (cards, documents). Not for UI." }
  }
}
